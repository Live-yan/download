[Unit]
Description=Webmin offline administration
After=network.target
[Service]
Type=simple
User=root
Group=root
UMask=0077
Environment=WEBMIN_CONFIG=/etc/webmin
Environment=WEBMIN_VAR=/var/webmin
RuntimeDirectory=webmin-offline
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/perl /usr/libexec/webmin/miniserv.pl --nofork /etc/webmin/miniserv.conf
ExecReload=/bin/kill -USR1 $MAINPID
KillMode=mixed
TimeoutStopSec=30
Restart=on-failure
RestartSec=3
[Install]
WantedBy=multi-user.target
